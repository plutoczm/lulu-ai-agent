# Copy to .env.local and fill local secrets.
DASHSCOPE_API_KEY=

DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

BAIDU_QIANFAN_API_KEY=
BAIDU_SEARCH_ENABLED=true

BAILIAN_RAG_ENABLED=false
BAILIAN_WORKSPACE_ID=
BAILIAN_INDEX_ID=

PGVECTOR_ENABLED=true
LOCAL_RAG_FALLBACK_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=lulu_ai_agent
POSTGRES_USER=lulu_ai_agent
POSTGRES_PASSWORD=

MCP_ENABLED=false
AMAP_MAPS_API_KEY=
PEXELS_API_KEY=

# Conversation channel integrations
QQ_BOT_ENABLED=false
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_TRANSPORT=websocket
QQ_BOT_WEBHOOK_PORT=8132
QQ_BOT_WEBHOOK_PATH=/qqbot/webhook
QQ_BOT_HEALTH_PORT=8131
QQ_BOT_GROUP_COACH_ENABLED=false
QQ_BOT_MARKDOWN=false
LULU_CHANNEL_TOKEN=
QQ_BOT_CHANNEL_TOKEN=
QQ_BOT_COACH_API=http://127.0.0.1:8123/api/channel/coach/suggest

# Android mobile assistant for both WeChat and QQ.
# Uses NotificationListener + Accessibility/OCR + overlay; share/process-text remains a manual fallback.
# No chat-app hook and no automatic sending.
ANDROID_ASSISTANT_ENABLED=false

# Voice ingestion / ASR
VOICE_ASR_ENABLED=true
VOICE_ASR_MODEL=paraformer-realtime-v2
VOICE_ASR_MAX_BYTES=6291456

# Model routing (pi-ai inspired provider/model registry)
MODEL_ROUTE_COACH=deepseek,dashscope
MODEL_ROUTE_AGENT=deepseek,dashscope
MODEL_ROUTE_FAST=dashscope,deepseek
MODEL_ROUTE_MEMORY=ollama

# Optional custom Ollama model directory
OLLAMA_MODELS=

# Codex app-server (uses the same ChatGPT OAuth token)
CODEX_COMMAND=codex.cmd
CODEX_WORKDIR=../..
